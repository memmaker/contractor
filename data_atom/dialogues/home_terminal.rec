%rec: OpeningBranch

cond: true
goto: DefaultIntroduction

%rec: Nodes

name: DefaultIntroduction
npc: ** Contractor Client Interface **
+ > Welcome
effect: None
#
# Starter Mission
o_text: (Job offer) Extract money, reward: 50% cut.
o_id: job_offer
o_cond: !HasFlag('JobAccepted(starter)') && !HasFlag('JobDeclined(starter)') && !HasFlag('Killed(jacob_thorne)')
o_goto: starter_mission
#
#
# Chapter 1 hook
o_text: (New job offer) A mansion outside the wall.
o_id: chapter1_offer
o_cond: HasFlag('QuestCompleted(starter)')
o_goto: chapter1_offer
#
# Dead Man's Switch
o_text: (IMPORTANT) Last message from Grim
o_cond: HasFlag('Killed(grim_beard)')
o_goto: DeadMansSwitch
#
o_text: Leave.
o_id: leave
o_goto: End

### Main Quest Delivery if grim_beard dies ###

name: DeadMansSwitch
npc: ** Contractor Client Interface **
+ > Accessing private records..
#
o_text: <Confirm>
o_goto: ReadGrimsLastMessage
#
o_text: Leave.
o_goto: End

name: ReadGrimsLastMessage
npc: ** Contractor Client Interface **
+ > Right, my turn to greet the reaper.
+ > I just hope I made a good choice with my heir.
+ > Ok, let's cut this crap. I am dead.
+ > Now listen up or you will join me early.
+ > Some high and mighty assholes are planning to make this world even worse.
+ > You should talk to Miguel, he knows more.
+ > If I were still young, or you know, alive, I would look into it.
+ > I'm out.
+ >
+ > Grim
#
effect: SetFlag('KnowsAbout(apocalypse)')
#
o_text: <Confirm>
o_goto: End
#
o_text: FUCK.
o_goto: End

### Starter Mission BEGIN ###

name: starter_mission
npc: ** Contractor Client Interface **
+ > Extract $500 from Daniel Harker.
+ > He is a Ripperdoc in the Northern Rim of Edge Haven.
+ > He owes Jacob.
effect: SetFlag('JobRead(starter)')
#
o_text: Accept the job.
o_id: accept_job
o_goto: starter_accept
#
o_text: Decline the job.
o_id: decline_job
o_goto: starter_decline
#
o_text: Go back.
o_goto: DefaultIntroduction

name: starter_accept
npc: ** Contractor Client Interface **
+ > Deposit half of the money ($250) in the dead drop, as usual.
+ > You can keep the other half.
#
effect: SetFlag('JobAccepted(starter)')
#
# This will script wait for the player to deposit the money in the dead drop.
effect: RunScript('dead_drop_01')
#
o_text: Go back.
o_goto: DefaultIntroduction
#
o_text: Leave.
o_id: accepted_leave
o_goto: End

name: starter_decline
npc: ** Contractor Client Interface **
+ > The client has been informed.
effect: SetFlag('JobDeclined(starter)')
effect: RunScript('other_assassin_gets_job')
#
o_text: Go back.
o_goto: DefaultIntroduction
#
o_text: Leave.
o_id: declined_leave
o_goto: End

name: End
npc: ** Contractor Client Interface **
+ > Have a nice day.
effect: EndConversation

### Starter Mission END ###

### Chapter 1 hook ###

name: chapter1_offer
npc: ** Contractor Client Interface **
+ > Somebody rich is hiding in a mansion outside the wall.
+ > Nobody knows where. Find it.
+ > Payment: more sat than you have ever seen.
#
o_text: Take the job. (Ends the demo)
o_id: chapter1_accept
o_goto: chapter1_accept
#
o_text: Not yet.
o_goto: DefaultIntroduction

name: chapter1_accept
npc: ** Contractor Client Interface **
+ > Job accepted. Good luck, contractor.
effect: EndDemo
