%rec: OpeningBranch

cond: true
goto: DefaultIntroduction

%rec: Nodes

name: DefaultIntroduction
npc: ** Contractor Client Interface **
+ > Welcome
effect: None
#
# Starter Mission
o_text: (Job offer) Extract money, reward: 50% cut.
o_id: job_offer
o_cond: !HasFlag('JobAccepted(starter)') && !HasFlag('JobDeclined(starter)') && !HasFlag('Killed(jacob_thorne)')
o_goto: starter_mission
#
#
# Chapter 1 hook
o_text: (New job offer) A mansion outside the wall.
o_id: chapter1_offer
o_cond: HasFlag('QuestCompleted(starter)')
o_goto: chapter1_offer
#
# Side contracts: a vague lead to the client
#
o_text: (Job offer) Lost property, southside.
o_id: lead_duck
o_cond: !(HasFlag('JobAccepted(duck)') || HasFlag('TalkedTo(synth_duck)'))
o_goto: lead_duck
#
o_text: (Job offer) A keepsake from outside the wall.
o_id: lead_tags
o_cond: !(HasFlag('JobAccepted(tags)') || HasFlag('took_dog_tag'))
o_goto: lead_tags
#
o_text: (Job offer) Pest control, no questions.
o_id: lead_rats
o_cond: !(HasFlag('JobAccepted(rats)') || HasFlag('cleaner_went_down'))
o_goto: lead_rats
#
o_text: (Job offer) Debt collection, commerce district.
o_id: lead_bar_tab
o_cond: !(HasFlag('b_bar_tab_accepted'))
o_goto: lead_bar_tab
#
o_text: (Job offer) Paperwork retrieval, spaceport.
o_id: lead_freight
o_cond: !(HasFlag('b_freight_accepted'))
o_goto: lead_freight
#
o_text: (Job offer) Recover stolen goods. Quietly.
o_id: lead_shift
o_cond: !(HasFlag('b_shift_accepted'))
o_goto: lead_shift
#
o_text: (Job offer) Lost and found, corporate district.
o_id: lead_badge
o_cond: !(HasFlag('TalkedTo(chief_landry)') || HasItem('bat_badge'))
o_goto: lead_badge
#
o_text: (Job offer) Crowd control, EBI campus.
o_id: lead_silence
o_cond: !(HasFlag('silence_accepted') || HasFlag('TalkedTo(protester_ines)'))
o_goto: lead_silence
#
o_text: (Job offer) A widow in trouble, western residential.
o_id: lead_rent
o_cond: !(HasFlag('TalkedTo(widow_marla)'))
o_goto: lead_rent
#
o_text: (Job offer) Courier pickup, freighter cargo.
o_id: lead_slow_boat
o_cond: !(HasFlag('JobAccepted(slow_boat)'))
o_goto: lead_slow_boat
#
o_text: (Job offer) A personal matter, Terra Vitae.
o_id: lead_sweet_revenge
o_cond: !(HasFlag('JobAccepted(sweet_revenge)'))
o_goto: lead_sweet_revenge
#
o_text: (Job offer) Parts hunt for a collector.
o_id: lead_old_harley
o_cond: !(HasFlag('JobAccepted(old_harley)'))
o_goto: lead_old_harley
#
o_text: (Job offer) Night watch, nightclub.
o_id: lead_ecto
o_cond: !(HasFlag('JobAccepted(ecto)'))
o_goto: lead_ecto
#
o_text: (Job offer) Courier work for a family without papers.
o_id: lead_false_papers
o_cond: !(HasFlag('JobAccepted(false_papers)'))
o_goto: lead_false_papers
#
o_text: (Job offer) Information wanted: one person's whereabouts.
o_id: lead_payback
o_cond: !(HasFlag('JobAccepted(payback)'))
o_goto: lead_payback
#
o_text: (Job offer) Investigation, off the books.
o_id: lead_carmen
o_cond: !(HasFlag('JobAccepted(carmen)'))
o_goto: lead_carmen
#
o_text: (Job offer) Signature needed, deadline tight.
o_id: lead_proxy
o_cond: !(HasFlag('JobAccepted(proxy)'))
o_goto: lead_proxy
#
o_text: (Job offer) Data recovery for an orbital firm.
o_id: lead_holiday
o_cond: !(HasFlag('JobAccepted(holiday)'))
o_goto: lead_holiday
#
o_text: (Job offer) Missing person, known face.
o_id: lead_deadline
o_cond: !(HasFlag('JobAccepted(deadline)'))
o_goto: lead_deadline
#
# Chapter 2/3: dealing with E.
o_text: Report Faust's location to E.
o_id: report_faust
o_cond: HasFlag('TalkedTo(logan_faust)') && !HasFlag('faust_sold_out') && !HasFlag('Killed(logan_faust)')
o_goto: report_faust
#
o_text: Sell the cryo lab to E.
o_id: sell_lab
o_cond: HasFlag('KnowsAbout(cryo_lab)') && !HasFlag('faust_sold_out')
o_goto: sell_lab
#
o_text: Retire. Spend it while it lasts.
o_id: retire
o_cond: HasFlag('KnowsAbout(ticket_scam)')
o_goto: retire
#
# Dead Man's Switch
o_text: (IMPORTANT) Last message from Grim
o_cond: HasFlag('Killed(grim_beard)')
o_goto: DeadMansSwitch
#
o_text: Leave.
o_id: leave
o_goto: End

### Main Quest Delivery if grim_beard dies ###

name: DeadMansSwitch
npc: ** Contractor Client Interface **
+ > Accessing private records..
#
o_text: <Confirm>
o_goto: ReadGrimsLastMessage
#
o_text: Leave.
o_goto: End

name: ReadGrimsLastMessage
npc: ** Contractor Client Interface **
+ > Right, my turn to greet the reaper.
+ > I just hope I made a good choice with my heir.
+ > Ok, let's cut this crap. I am dead.
+ > Now listen up or you will join me early.
+ > Some high and mighty assholes are planning to make this world even worse.
+ > You should talk to Miguel, he knows more.
+ > If I were still young, or you know, alive, I would look into it.
+ > I'm out.
+ >
+ > Grim
#
effect: SetFlag('KnowsAbout(apocalypse)')
#
o_text: <Confirm>
o_goto: End
#
o_text: FUCK.
o_goto: End

### Starter Mission BEGIN ###

name: starter_mission
npc: ** Contractor Client Interface **
+ > Extract $500 from Daniel Harker.
+ > He is a Ripperdoc in the Northern Rim of Edge Haven.
+ > He owes Jacob.
effect: SetFlag('JobRead(starter)')
#
o_text: Accept the job.
o_id: accept_job
o_goto: starter_accept
#
o_text: Decline the job.
o_id: decline_job
o_goto: starter_decline
#
o_text: Go back.
o_goto: DefaultIntroduction

name: starter_accept
npc: ** Contractor Client Interface **
+ > Deposit half of the money ($250) in the dead drop, as usual.
+ > You can keep the other half.
#
effect: SetFlag('JobAccepted(starter)')
#
# This will script wait for the player to deposit the money in the dead drop.
effect: RunScript('dead_drop_01')
#
o_text: Go back.
o_goto: DefaultIntroduction
#
o_text: Leave.
o_id: accepted_leave
o_goto: End

name: starter_decline
npc: ** Contractor Client Interface **
+ > The client has been informed.
effect: SetFlag('JobDeclined(starter)')
effect: RunScript('other_assassin_gets_job')
#
o_text: Go back.
o_goto: DefaultIntroduction
#
o_text: Leave.
o_id: declined_leave
o_goto: End

name: End
npc: ** Contractor Client Interface **
+ > Have a nice day.
effect: EndConversation

### Starter Mission END ###

### Chapter 1 hook ###

name: chapter1_offer
npc: ** Contractor Client Interface **
+ > Somebody rich is hiding in a mansion outside the wall.
+ > Nobody knows where. Find it.
+ > Payment: more sat than you have ever seen.
#
o_text: Take the job.
o_id: chapter1_accept
o_goto: chapter1_accept
#
o_text: Not yet.
o_goto: DefaultIntroduction

name: chapter1_accept
npc: ** Contractor Client Interface **
+ > Job accepted. Good luck, contractor.
effect: SetFlag('JobAccepted(mansion)')
effect: EndConversation

### Chapter 2/3: dealing with E. ###

name: report_faust
npc: ** Contractor Client Interface **
+ > Location received. Payment transferred: 5000 sat.
+ > A team is on its way. Stay out of theirs.
effect: SetFlag('faust_sold_out')
effect: PlayerAddGold(5000)
effect: RunScript('ebi_strike')
#
o_text: Leave.
o_goto: End

name: sell_lab
npc: ** Contractor Client Interface **
+ > The lab is ours now. 50000 sat, as agreed.
+ > Pleasure doing business, contractor.
effect: PlayerAddGold(50000)
effect: EndGame('sold_lab')

name: retire
npc: ** Contractor Client Interface **
+ > Account closed.
effect: EndGame('gave_up')

### Side contract leads ###

name: lead_duck
npc: ** Contractor Client Interface **
+ > Pet retrieval. Owner is distraught.
