%rec: OpeningBranch

cond: !HasFlag('Killed(taxi_driver)')
goto: NoTaxi

cond: HasFlag('Killed(taxi_driver)') && !HasFlag('searched_taxi')
goto: SearchTaxi

cond: HasFlag('Killed(taxi_driver)') && HasFlag('searched_taxi')
goto: UseTaxi

%rec: Nodes

name: NoTaxi
npc: (This is a taxi, but the owner might not want you to use it.)
effect: EndConversation

name: SearchTaxi
npc: (Since the driver is dead, you proceed to search the taxi.)
effect: SetFlag('searched_taxi')
#
o_text: Drive to a location.
o_goto: UseTaxi
#
o_text: Leave the taxi.
o_goto: Bye

name: UseTaxi
npc: (Where do you want to go?)
#
o_text: Home
o_cond: !IsMap('zone_residential_south')
o_goto: HeadQuarters
#
o_text: The eastern rim district (Cognetic Bastards & La Boom).
o_cond: !IsMap('zone_commerce')
o_goto: EasternRim
#
o_text: The eastern residential district.
o_cond: !IsMap('zone_residential_east')
o_goto: ResidentialEast
#
o_text: The western residential district.
o_cond: !IsMap('zone_residential_west')
o_goto: ResidentialWest
#
o_text: The Terra Vitae headquarters.
o_cond: !IsMap('hq_terra_vitae')
o_goto: TerraVitae
#
o_text: The mansion outside the wall.
o_id: go_mansion
o_cond: HasFlag('LocationKnown(mansion)') && !IsMap('mansion')
o_goto: Mansion
#
o_text: Leave
o_goto: Bye

name: Bye
npc: (You decide to leave the taxi.)
effect: EndConversation

name: HeadQuarters
npc: (You drive back to the southern residential district.)
effect: Transition('zone_residential_south', 'taxi_stand')
effect: AdvanceTimeByMinutes(15)
effect: EndWithChatter

name: EasternRim
npc: (You drive over to the eastern rim district.)
effect: Transition('zone_commerce', 'taxi_stand')
effect: AdvanceTimeByMinutes(15)
effect: EndWithChatter

name: ResidentialEast
npc: (You drive over to the eastern residential district.)
effect: Transition('zone_residential_east', 'taxi_stand')
effect: AdvanceTimeByMinutes(15)
effect: EndWithChatter

name: ResidentialWest
npc: (You drive over to the western residential district.)
effect: Transition('zone_residential_west', 'taxi_stand')
effect: AdvanceTimeByMinutes(15)
effect: EndWithChatter

name: TerraVitae
npc: (You drive up to the Terra Vitae headquarters.)
effect: Transition('hq_terra_vitae', 'taxi_stand')
effect: AdvanceTimeByMinutes(20)
effect: EndWithChatter

name: Mansion
npc: (You drive out through the southern gate to the mansion.)
effect: Transition('mansion', 'taxi_stand')
effect: AdvanceTimeByMinutes(30)
effect: EndWithChatter
