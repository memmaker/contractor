# Fighter B: kill Harker, key from the filing cabinet, rob the stash, deposit. Then the clinic reopens after 2 days.

%rec: outcomes

if: HasFlag('QuestCompleted(starter, reward_received)') && HasFlag('clinic_reopened')

%rec: frames

if: true
do: Talk('grim_beard')
do: Choose('keys_now')

if: true
do: Use('home_terminal')
do: Choose('job_offer')
do: Choose('accept_job')
do: Choose('accepted_leave')

# fighter build: Perception 8 + tagged Ranged Combat = 46%, the pistol by the bed, the clip from the dead drop
if: true
do: PickUp('10mm_pistol')
do: Equip('10mm_pistol')
do: SetSkill('RangedCombat', 46)
do: Use('dead_drop')
do: Take('10mm_jhp')

if: true
do: Kill('daniel_harker')

if: true
do: Use('hospital_filing_cabinet')
do: Take('doc_stash_key')

if: true
do: Use('ripperdoc_stash')
do: Take('gold')

if: true
do: Use('dead_drop')
do: Put('gold', 250)

if: true
do: WaitHours(7)

if: true
do: Use('dead_drop')
do: Take('binge')

if: true
do: WaitHours(50)
