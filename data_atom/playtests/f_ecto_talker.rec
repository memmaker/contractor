if: true
do: ForceChecks('success')
do: Talk('runner_pixel')
do: Choose('ecto_talk')

if: true
do: Use('ecto_stash')
do: Take('holo_emitter')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

