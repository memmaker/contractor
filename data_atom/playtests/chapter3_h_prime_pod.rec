# Chapter 3 (BioChemistry): hack into the cellar, then dose pod 3's cryoprotectant by hand instead of fetching the fuse.

%rec: outcomes

if: GameOver() && HasFlag('Ending(cryo_sleep)') && HasFlag('PodFixed(3)')

%rec: frames

if: true
do: ForceChecks('success')
do: Talk('taxi_driver')
do: Choose('ask_mansion')
do: Choose('mansion_persuade')
do: Choose('mansion_now')

# thief build: the service door is an easy lock, the safe a hard one, the terminal a hard hack
if: true
do: SetSkill('Mechanics', 200)
do: SetSkill('Technology', 200)
do: SetSkill('Stealth', 200)
do: Use('mansion_service_door')

# Faust sits in his study: the five starting picks have to last, so leave his safe alone and open the cellar through the terminal
if: true
do: Sneak()
do: GoTo('faust_study')

if: true
do: Use('faust_terminal')
do: Choose('hack_terminal')
do: Choose('hacked_back')
do: Choose('terminal_leave')

if: true
do: GoTo('cellar_stairs')

if: true
do: Use('cryo_pod_3')
do: Choose('prime_pod_3')
do: Choose('climb_in_3_primed')
