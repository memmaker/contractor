# Proxy Vote (avoider).

%rec: outcomes

if: HasFlag('QuestCompleted(proxy_vote, delivered)') && !HasFlag('Killed(shareholder_hal)') && !HasItem('proxy_vote_stash_key')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_carleton')
do: Choose('proxy_vote_accept')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: SetSkill('Stealth', 200)
do: SetSkill('Mechanics', 200)
do: Give('mechanical_lockpick(5)')
do: Sneak()
do: Use('proxy_vote_stash')
do: Take('proxy_vote')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_carleton')
do: Choose('proxy_vote_give')
