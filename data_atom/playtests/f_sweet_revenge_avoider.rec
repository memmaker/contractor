# Sweet Revenge (avoider).

%rec: outcomes

if: HasFlag('QuestCompleted(sweet_revenge, delivered)') && !HasFlag('Killed(star_shani)') && !HasItem('sweet_revenge_stash_key')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_stromberg')
do: Choose('sweet_revenge_accept')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_terra_vitae')

if: true
do: SetSkill('Stealth', 200)
do: SetSkill('Mechanics', 200)
do: Give('mechanical_lockpick(5)')
do: Sneak()
do: Use('sweet_revenge_stash')
do: Take('bd_master')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_stromberg')
do: Choose('sweet_revenge_give')
