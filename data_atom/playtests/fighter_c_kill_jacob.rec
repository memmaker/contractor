# Fighter C: walk east, threaten Jacob, fail (forced), kill him.

%rec: outcomes

if: HasFlag('QuestCompleted(starter, killed_client)')

%rec: frames

if: true
do: Talk('grim_beard')
do: Choose('keys_now')

if: true
do: Use('home_terminal')
do: Choose('job_offer')
do: Choose('accept_job')
do: Choose('accepted_leave')

# fighter build: Jacob has 80 hit points under 20 DR, so a frontal duel takes the SMG on burst, not the bedside pistol
if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: FireMode('Burst')
do: SetSkill('RangedCombat', 150)
do: Use('dead_drop')
do: Take('10mm_jhp')

if: true
do: GoTo('street_to_east')

if: true
do: ForceChecks('fail')
do: Talk('jacob_thorne')
do: Choose('intimidate')
do: Choose('fight')

# the forced failure was for the intimidation only; the duel is fought with real dice
if: true
do: ForceChecks('random')
do: Kill('jacob_thorne')
