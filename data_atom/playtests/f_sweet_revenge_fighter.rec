# Sweet Revenge (fighter).

%rec: outcomes

if: HasFlag('QuestCompleted(sweet_revenge, delivered)') && HasFlag('Killed(star_shani)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_stromberg')
do: Choose('sweet_revenge_accept')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_terra_vitae')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 80)
do: Kill('star_shani')

if: true
do: Unequip('10mm_smg')
do: PickUp('sweet_revenge_stash_key')
do: Use('sweet_revenge_stash')
do: Take('bd_master')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_stromberg')
do: Choose('sweet_revenge_give')
