# Payback (fighter): do it yourself.

%rec: outcomes

if: HasFlag('QuestCompleted(payback, killed)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_east')

if: true
do: Talk('junkie_stripe')
do: Choose('payback_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: GoTo('street_to_wall')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 100)
do: Kill('informant_pinky')

if: true
do: Unequip('10mm_smg')

if: true
do: GoTo('street_to_south')

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_east')

if: true
do: Talk('junkie_stripe')
do: Choose('payback_dead')
