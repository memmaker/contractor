# False Papers (talker).

%rec: outcomes

if: HasFlag('QuestCompleted(false_papers, delivered)') && !HasFlag('Killed(forger_nils)') && HasItem('false_papers_stash_key')

%rec: frames

if: true
do: Talk('refugee_amira')
do: Choose('false_papers_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: ForceChecks('success')
do: Talk('forger_nils')
do: Choose('false_papers_talk')

if: true
do: Use('false_papers_stash')
do: Take('forged_sin')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('refugee_amira')
do: Choose('false_papers_give')
