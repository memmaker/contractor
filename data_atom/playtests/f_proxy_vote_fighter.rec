# Proxy Vote (fighter).

%rec: outcomes

if: HasFlag('QuestCompleted(proxy_vote, delivered)') && HasFlag('Killed(shareholder_hal)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_carleton')
do: Choose('proxy_vote_accept')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 80)
do: Kill('shareholder_hal')

if: true
do: Unequip('10mm_smg')
do: PickUp('proxy_vote_stash_key')
do: Use('proxy_vote_stash')
do: Take('proxy_vote')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_carleton')
do: Choose('proxy_vote_give')
