# Deadline: pay off the marker, send Holly home.

%rec: outcomes

if: HasFlag('QuestCompleted(deadline, home)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('assistant_caitlin')
do: Choose('deadline_accept')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Give('gold(100)')
do: Talk('loanshark_fargo')
do: Choose('fargo_holly')
do: Choose('fargo_pay')

if: true
do: Talk('holly_jones')
do: Choose('holly_go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('assistant_caitlin')
do: Choose('deadline_home')
