# Deadline (talker).

%rec: outcomes

if: HasFlag('QuestCompleted(deadline, delivered)') && !HasFlag('Killed(loanshark_fargo)') && HasItem('deadline_stash_key')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('assistant_caitlin')
do: Choose('deadline_accept')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: ForceChecks('success')
do: Talk('loanshark_fargo')
do: Choose('deadline_talk')

if: true
do: Use('deadline_stash')
do: Take('holly_marker')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('assistant_caitlin')
do: Choose('deadline_give')
