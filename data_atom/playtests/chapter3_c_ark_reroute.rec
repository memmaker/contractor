# Chapter 3 C (tech): talk ARK through rerouting pod 4's heater power into pod 3, then climb into pod 3.

%rec: outcomes

if: GameOver() && HasFlag('Ending(cryo_sleep)') && HasFlag('PodFixed(3)')

%rec: frames

if: true
do: ForceChecks('success')
do: Talk('taxi_driver')
do: Choose('ask_mansion')
do: Choose('mansion_persuade')
do: Choose('mansion_now')

if: true
do: Talk('mansion_guard')
do: Choose('claim_caterer')
do: Choose('gate_thanks')

if: true
do: GoTo('faust_study')

if: true
do: Talk('logan_faust')
do: Choose('not_here_to_kill')
do: Choose('persuade_faust')
do: Choose('ask_pod')
do: Choose('pod_thanks')

if: true
do: GoTo('cellar_stairs')

if: true
do: Use('ark_terminal')
do: Choose('pod3_fault')
do: Choose('reroute_power')
do: Choose('reroute_back')
do: Choose('ark_leave')

if: true
do: Use('cryo_pod_3')
do: Choose('climb_in_3')
