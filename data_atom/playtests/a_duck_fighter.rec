# The Duck (fighter): take Anna's job, shoot through the sewer rats, carry Coco home.

%rec: outcomes

if: HasFlag('QuestCompleted(the_duck, returned)')

%rec: frames

if: true
do: Talk('anna_whitaker')
do: Choose('ask_duck')
do: Choose('accept_duck')
do: Choose('accept_bye')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Equip('10mm_smg')
do: FireMode('Burst')
do: SetSkill('RangedCombat', 150)
do: GoTo('man_hole_east')

if: true
do: GoTo('duck_pond')

if: true
do: Talk('synth_duck')
do: Choose('duck_come')

if: true
do: GoTo('man_hole_east')

if: true
do: Talk('anna_whitaker')
do: Choose('give_duck')
do: Choose('duck_thanks')
