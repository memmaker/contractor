# Fighter C variant: make a deal with Harker first, kill Jacob, collect 300 from Harker.

%rec: outcomes

if: HasFlag('QuestCompleted(starter, killed_client_for_daniel)') && HasFlag('harker_paid_for_jacob')

%rec: frames

if: true
do: Talk('grim_beard')
do: Choose('keys_now')

if: true
do: Use('home_terminal')
do: Choose('job_offer')
do: Choose('accept_job')
do: Choose('accepted_leave')

# fighter build: Perception 8 + tagged Ranged Combat = 46%, the pistol by the bed, the clip from the dead drop
if: true
do: PickUp('10mm_pistol')
do: Equip('10mm_pistol')
do: SetSkill('RangedCombat', 46)
do: Use('dead_drop')
do: Take('10mm_jhp')

if: true
do: Talk('daniel_harker')
do: Choose('not_collecting')
do: Choose('ask_jacob')
do: Choose('relationship')
do: Choose('take_care_of_jacob')
do: Choose('deal_kill_jacob')
do: Choose('kill_deal_thanks')
do: Choose('bye')

if: true
do: GoTo('street_to_east')

if: true
do: ForceChecks('fail')
do: Talk('jacob_thorne')
do: Choose('intimidate')
do: Choose('fight')

if: true
do: Kill('jacob_thorne')

if: true
do: GoTo('street_to_south')

if: true
do: Talk('daniel_harker')
do: Choose('jacob_dead_paid')
