# Carmen (avoider): bribe Tito, crack the trunk for her diary.

%rec: outcomes

if: HasFlag('QuestCompleted(carmen, arrested)') && HasItem('carmen_diary')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: Talk('detective_rourke')
do: Choose('carmen_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: ForceChecks('fail')
do: Talk('stagehand_tito')
do: Choose('tito_ask')
do: Choose('tito_pay')

if: true
do: ForceChecks('none')
do: SetSkill('Stealth', 200)
do: SetSkill('Mechanics', 200)
do: Give('mechanical_lockpick(5)')
do: Sneak()
do: Use('carmen_trunk')
do: Take('carmen_diary')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: Talk('detective_rourke')
do: Choose('carmen_accuse')
