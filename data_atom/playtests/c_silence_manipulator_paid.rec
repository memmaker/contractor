# Silence (manipulator, paid): pay Ines 300 to go home, bill Voss 500.

%rec: outcomes

if: HasFlag('QuestCompleted(silence, paid_off)') && HasFlag('silence_paid')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

# 300 sat for Ines: the courier lockbox by the BAT notice
if: true
do: SetSkill('Mechanics', 120)
do: Use('corp_lockbox')
do: Take('gold')

if: true
do: GoTo('street_to_ebi')

if: true
do: Talk('adrian_voss')
do: Choose('silence_ask')
do: Choose('silence_accept')
do: Choose('silence_accepted_done')

if: true
do: GoTo('campus_gate')

if: true
do: Talk('protester_ines')
do: Choose('ines_pay')
do: Choose('ines_paid_done')

if: true
do: GoTo('hq_gate')

if: true
do: Talk('adrian_voss')
do: Choose('silence_report')
do: Choose('silence_paid_done')

