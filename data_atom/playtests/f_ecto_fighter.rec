# Ecto (fighter).

%rec: outcomes

if: HasFlag('QuestCompleted(ecto, delivered)') && HasFlag('Killed(runner_pixel)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Talk('club_lou')
do: Choose('ecto_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_east')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 80)
do: Kill('runner_pixel')

if: true
do: Unequip('10mm_smg')
do: PickUp('ecto_stash_key')
do: Use('ecto_stash')
