# Proxy Vote (bribe).

%rec: outcomes

if: HasFlag('QuestCompleted(proxy_vote, bribed)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_carleton')
do: Choose('proxy_vote_accept')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('shareholder_hal')
do: Choose('proxy_vote_bribe')
