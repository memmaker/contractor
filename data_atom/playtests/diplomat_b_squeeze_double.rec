# Diplomat B: renegotiate, want double (social Hard, forced success).

%rec: outcomes

if: HasFlag('QuestCompleted(starter, client_extorted)')

%rec: frames

if: true
do: Talk('grim_beard')
do: Choose('keys_now')

if: true
do: Use('home_terminal')
do: Choose('job_offer')
do: Choose('accept_job')
do: Choose('accepted_leave')

if: true
do: GoTo('street_to_east')

if: true
do: ForceChecks('success')
do: Talk('jacob_thorne')
do: Choose('renegotiate')
do: Choose('want_double')
do: Choose('right_choice')
do: Leave()
