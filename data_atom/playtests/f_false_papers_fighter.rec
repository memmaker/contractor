# False Papers (fighter).

%rec: outcomes

if: HasFlag('QuestCompleted(false_papers, delivered)') && HasFlag('Killed(forger_nils)')

%rec: frames

if: true
do: Talk('refugee_amira')
do: Choose('false_papers_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 80)
do: Kill('forger_nils')

if: true
do: Unequip('10mm_smg')
do: PickUp('false_papers_stash_key')
do: Use('false_papers_stash')
do: Take('forged_sin')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('refugee_amira')
do: Choose('false_papers_give')
