# Silence (avoider): take the contract, then warn Ines instead. She leaves; Voss learns nothing and pays nothing.

%rec: outcomes

if: HasFlag('QuestCompleted(silence, warned)') && !HasFlag('silence_paid')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: GoTo('street_to_ebi')

if: true
do: Talk('adrian_voss')
do: Choose('silence_ask')
do: Choose('silence_accept')
do: Choose('silence_accepted_done')

if: true
do: GoTo('campus_gate')

if: true
do: Talk('protester_ines')
do: Choose('ines_warn')
do: Choose('ines_warned_done')
