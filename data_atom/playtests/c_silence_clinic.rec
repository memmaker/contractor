# Silence (BioChemistry): read the chlorine in Ines's cough, she goes to the Terra Vitae clinic, bill Voss.

%rec: outcomes

if: HasFlag('QuestCompleted(silence, clinic)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: GoTo('street_to_ebi')

if: true
do: Talk('adrian_voss')
do: Choose('silence_ask')
do: Choose('silence_accept')
do: Choose('silence_accepted_done')

if: true
do: GoTo('campus_gate')

if: true
do: ForceChecks('success')
do: Talk('student_pim')
do: Choose('student_ines')
do: Choose('ines_back')
do: Choose('student_leave')
do: Talk('protester_ines')
do: Choose('ines_lungs')
do: Choose('ines_clinic_done')

if: true
do: GoTo('hq_gate')

if: true
do: Talk('adrian_voss')
do: Choose('silence_report')
do: Choose('silence_paid_done')
