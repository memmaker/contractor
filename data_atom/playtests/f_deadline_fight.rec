# Deadline (fighter): the threat fails, so fight Fargo and his goons.

%rec: outcomes

if: HasFlag('QuestCompleted(deadline, home)') && HasFlag('Killed(loanshark_fargo)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('assistant_caitlin')
do: Choose('deadline_accept')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 100)
do: ForceChecks('fail')
do: Talk('loanshark_fargo')
do: Choose('fargo_holly')
do: Choose('fargo_threaten')

if: true
do: Kill('loanshark_fargo')

if: true
do: Kill('fargo_goon')

if: true
do: Kill('fargo_goon')

if: true
do: Unequip('10mm_smg')
do: Talk('holly_jones')
do: Choose('holly_go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('assistant_caitlin')
do: Choose('deadline_home')
