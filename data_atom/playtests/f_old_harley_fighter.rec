# The '94 Harley (fighter).

%rec: outcomes

if: HasFlag('QuestCompleted(old_harley, delivered)') && HasFlag('Killed(chopper_ratchet)')

%rec: frames

if: true
do: Talk('biker_dizzy')
do: Choose('old_harley_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 80)
do: Kill('chopper_ratchet')

if: true
do: Unequip('10mm_smg')
do: PickUp('old_harley_stash_key')
do: Use('old_harley_stash')
do: Take('harley_ignition')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('biker_dizzy')
do: Choose('old_harley_give')
