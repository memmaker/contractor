# Chapter 3 E (against all odds): broadcast Faust's files from the ARK console and die famous.

%rec: outcomes

if: GameOver() && HasFlag('Ending(against_all_odds)')

%rec: frames

if: true
do: ForceChecks('success')
do: Talk('taxi_driver')
do: Choose('ask_mansion')
do: Choose('mansion_persuade')
do: Choose('mansion_now')

if: true
do: Talk('mansion_guard')
do: Choose('claim_caterer')
do: Choose('gate_thanks')

if: true
do: GoTo('faust_study')

if: true
do: Talk('logan_faust')
do: Choose('not_here_to_kill')
do: Choose('persuade_faust')
do: Choose('ask_pod')
do: Choose('pod_thanks')

if: true
do: GoTo('cellar_stairs')

if: true
do: Use('ark_terminal')
do: Choose('broadcast_files')
