# A Holiday on Ice (avoider).

%rec: outcomes

if: HasFlag('QuestCompleted(holiday_on_ice, delivered)') && !HasFlag('Killed(engineer_morrow)') && !HasItem('holiday_on_ice_stash_key')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Talk('agent_nueman')
do: Choose('holiday_on_ice_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: SetSkill('Stealth', 200)
do: SetSkill('Mechanics', 200)
do: Give('mechanical_lockpick(5)')
do: Sneak()
do: Use('holiday_on_ice_stash')
do: Take('pump_specs')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Talk('agent_nueman')
do: Choose('holiday_on_ice_give')
