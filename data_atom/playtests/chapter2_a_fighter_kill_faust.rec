# Chapter 2 A (fighter): shoot the gate guards, drop everyone the gunfire draws out, take Mira's keys, and finish Faust in his study.

%rec: outcomes

if: HasFlag('Killed(logan_faust)') && HasFlag('QuestCompleted(recluse, faust_dead)')

%rec: frames

# a fighter packs every clip he can find: the one in the dead drop first
if: true
do: ForceChecks('success')
do: Use('dead_drop')
do: Take('10mm_jhp')
do: Talk('taxi_driver')
do: Choose('ask_mansion')
do: Choose('mansion_persuade')
do: Choose('mansion_now')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: FireMode('Burst')
do: SetSkill('RangedCombat', 150)
do: SetDerivedStat('HitPoints', 45)
do: SetDerivedStat('MeleeDamageBonus', 5)
do: Kill('mansion_guard')
do: Kill('mansion_guard')

# the shots carry: Mira comes running to the gate and dies there. Restock from the dead, take her keys,
# and let yourself in: the hall guard heard everything but cannot reach you without a key, so go and get him
if: true
do: PickUp('10mm_jhp')
do: PickUp('mansion_key')
do: Kill('mansion_guard')

if: true
do: GoTo('faust_study')
do: Kill('logan_faust')
