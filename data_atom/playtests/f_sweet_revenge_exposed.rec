# Sweet Revenge (avoider): crack Stromberg's safe, the ledger goes public.

%rec: outcomes

if: HasFlag('QuestCompleted(sweet_revenge, exposed)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_terra_vitae')

if: true
do: Talk('star_shani')
do: Choose('sweet_revenge_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: SetSkill('Stealth', 200)
do: SetSkill('Mechanics', 200)
do: Give('mechanical_lockpick(5)')
do: Sneak()
do: Use('stromberg_safe')
do: Take('stromberg_ledger')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_terra_vitae')

if: true
do: Talk('star_shani')
do: Choose('sweet_revenge_give_ledger')
