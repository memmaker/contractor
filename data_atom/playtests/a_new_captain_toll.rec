# R4: kill the gate captain, stay away two days, come back: a replacement holds the yard and charges a toll.

%rec: outcomes

if: HasFlag('a_new_captain') && HasFlag('a_toll_paid')

%rec: frames

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 60)
do: GoTo('street_to_wall')

if: true
do: ForceChecks('fail')
do: Talk('gate_captain')
do: Choose('ask_trucks')
do: Choose('intimidate')
do: Choose('fight')

if: true
do: Kill('gate_captain')

if: true
do: Unequip('10mm_smg')
do: GoTo('street_to_south')

if: true
do: WaitHours(50)

if: true
do: GoTo('street_to_wall')

if: true
do: Talk('gate_captain_2')
do: Choose('pay_toll')
