# Holiday on Ice (fighter): bluff Morrow, deliver, then shoot the cleaners.

%rec: outcomes

if: HasFlag('QuestCompleted(holiday, survived)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Talk('agent_nueman')
do: Choose('holiday_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: ForceChecks('success')
do: Talk('engineer_morrow')
do: Choose('morrow_bluff')

if: true
do: GoTo('street_to_commerce')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Talk('agent_nueman')
do: Choose('holiday_give')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 100)
do: WaitMinutes(31)

if: true
do: Kill('nueman_cleaner')

if: true
do: Kill('nueman_cleaner')
