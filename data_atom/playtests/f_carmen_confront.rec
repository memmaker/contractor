# Carmen (fighter): tell her you know.

%rec: outcomes

if: HasFlag('QuestCompleted(carmen, killed)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: Talk('detective_rourke')
do: Choose('carmen_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 100)
do: Talk('singer_carmen')
do: Choose('carmen_confront')

if: true
do: Kill('singer_carmen')

if: true
do: Unequip('10mm_smg')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: Talk('detective_rourke')
do: Choose('carmen_dead')
