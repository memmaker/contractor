# Carmen (talker).

%rec: outcomes

if: HasFlag('QuestCompleted(carmen, delivered)') && !HasFlag('Killed(singer_carmen)') && HasItem('carmen_stash_key')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: Talk('detective_rourke')
