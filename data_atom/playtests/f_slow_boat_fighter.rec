# The Slow Boat (fighter).

%rec: outcomes

if: HasFlag('QuestCompleted(slow_boat, delivered)') && HasFlag('Killed(smuggler_jalil)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Talk('fixer_kade')
do: Choose('slow_boat_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_east')

if: true
do: Give('10mm_smg(100)')
do: Give('10mm_jhp(48)')
do: Give('10mm_ap(48)')
do: Equip('10mm_smg')
do: SetSkill('RangedCombat', 80)
do: Kill('smuggler_jalil')

if: true
do: Unequip('10mm_smg')
do: PickUp('slow_boat_stash_key')
do: Use('slow_boat_stash')
do: Take('chiba_chip')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: Talk('fixer_kade')
do: Choose('slow_boat_give')
