# Sweet Revenge (grey): sell her location to Stromberg; she is gone by night.

%rec: outcomes

if: HasFlag('QuestCompleted(sweet_revenge, betrayed)') && HasFlag('shani_taken')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_terra_vitae')

if: true
do: Talk('star_shani')
do: Choose('sweet_revenge_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: Talk('exec_stromberg')
do: Choose('stromberg_betray')

if: true
do: WaitHours(7)
