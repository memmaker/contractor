# Rats (BioChemistry): brew a repellent in the cleaner's bucket, pour it on the trash heap, the rats move deeper. Abe approves.

%rec: outcomes

if: HasFlag('QuestCompleted(rats, paid)') && HasFlag('sewer_rats_moved') && !HasFlag('KilledByPlayer(rat)')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: ForceChecks('success')
do: Talk('cleaner')
do: Choose('ask_rats')
do: Choose('rats_repellent')
do: Choose('repellent_bye')

if: true
do: ForceChecks('none')
do: GoTo('street_to_south')

if: true
do: SetSkill('Stealth', 200)
do: GoTo('man_hole_east')

if: true
do: Sneak()
do: Use('sewer_trash')
do: Put('rat_repellent', 1)

if: true
do: GoTo('man_hole_east')

if: true
do: WaitHours(3)

if: HasFlag('sewer_rats_moved')
do: GoTo('street_to_west')

if: true
do: Talk('cleaner')
do: Choose('rats_done')
do: Choose('paid_bye')
