# Diplomat C: intimidate Jacob (Hard, forced success) after a kill, then ask for real work.

%rec: outcomes

if: HasFlag('QuestCompleted(starter)') && !HasFlag('jacob_better_job')
do: Fail('no mansion hint')

if: HasFlag('QuestCompleted(starter, client_backed_off)')

%rec: frames

if: true
do: Talk('grim_beard')
do: Choose('keys_now')

if: true
do: Use('home_terminal')
do: Choose('job_offer')
do: Choose('accept_job')
do: Choose('accepted_leave')

# fighter build: Perception 8 + tagged Ranged Combat = 46%, the pistol by the bed, the clip from the dead drop
if: true
do: PickUp('10mm_pistol')
do: Equip('10mm_pistol')
do: SetSkill('RangedCombat', 46)
do: Use('dead_drop')
do: Take('10mm_jhp')

# a kill nobody saw: a sewer rat

# Harker leaves the counter for the alley at 12:00 for ten minutes: slip into the toilet then.
# The cellar's other exit is the locked cell door into the mined sewers, so wait down there for his next absence.
if: true
do: WaitUntil('12:01')
do: GoTo('ripperdoc_toilet')
do: Kill('rat')
do: WaitUntil('12:01')
do: GoTo('secret_ladder')

if: true
do: GoTo('street_to_east')

if: true
do: ForceChecks('success')
do: Talk('jacob_thorne')
do: Choose('intimidate')
do: Choose('ask_real_work')
do: Choose('in_touch')
do: Leave()
