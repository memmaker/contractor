# Silence (manipulator, moved): talk Ines into protesting at BAT instead, bill Voss, find her at the BAT gate.

%rec: outcomes

if: HasFlag('QuestCompleted(silence, moved)') && IsOnMap('hq_bat') && HasFlag('ines_bat_seen')

%rec: frames

if: true
do: Talk('taxi_driver')
do: Choose('go_eastern_rim')

if: true
do: GoTo('street_to_corporate')

if: true
do: GoTo('street_to_ebi')

if: true
do: Talk('adrian_voss')
do: Choose('silence_ask')
do: Choose('silence_accept')
do: Choose('silence_accepted_done')

if: true
do: GoTo('campus_gate')

if: true
do: ForceChecks('success')
do: Talk('student_pim')
do: Choose('student_ines')
do: Choose('ines_back')
do: Choose('student_leave')
do: Talk('protester_ines')
do: Choose('ines_move')
do: Choose('ines_moved_done')

if: true
do: GoTo('hq_gate')

if: true
do: Talk('adrian_voss')
do: Choose('silence_report')
do: Choose('silence_paid_done')

if: true
do: GoTo('street_to_corporate')

if: true
do: GoTo('street_to_bat')

if: true
do: Talk('protester_ines')
do: Choose('ines_bat_leave')
