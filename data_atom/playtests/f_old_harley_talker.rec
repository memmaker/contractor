# The '94 Harley (talker).

%rec: outcomes

if: HasFlag('QuestCompleted(old_harley, delivered)') && !HasFlag('Killed(chopper_ratchet)') && HasItem('old_harley_stash_key')

%rec: frames

if: true
do: Talk('biker_dizzy')
do: Choose('old_harley_accept')

if: true
do: Talk('taxi_driver')
do: Choose('go_residential_west')

if: true
do: ForceChecks('success')
do: Talk('chopper_ratchet')
do: Choose('old_harley_talk')

if: true
do: Use('old_harley_stash')
do: Take('harley_ignition')

if: true
do: Talk('taxi_driver')
do: Choose('go_home')

if: true
do: Talk('biker_dizzy')
do: Choose('old_harley_give')
