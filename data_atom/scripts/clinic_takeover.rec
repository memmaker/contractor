# A few days after Harker dies, the clinic gets a new doctor:
# Drake if he was freed and lives, otherwise EBI sends a medic.
# Frames run strictly in order, so each branch is its own script.

%rec: definitions

%rec: outcomes

if: HasFlag('clinic(drake)') || HasFlag('clinic(ebi)')
do: SetFlag('clinic_reopened')

%rec: cancel

%rec: frames

if: HasFlag('Killed(daniel_harker)')
do: SaveTimeNow('harker_died')

if: IsDaysAfter('harker_died', 2)
do: RunScript('clinic_by_drake')
do: RunScript('clinic_by_ebi')
